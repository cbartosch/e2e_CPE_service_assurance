# Copy to .env. Every value below is a DEFAULT that the code already applies; this file exists to
# make the switches discoverable, not to be required. The service starts with no .env at all.

# ---------------------------------------------------------------------------------------------
# Safety switches. Both must be changed to reach a real external system. See
# IMPLEMENTATION_PLAN.md A4: a write adapter in simulation mode records the intent and returns a
# simulated result rather than calling out.
# ---------------------------------------------------------------------------------------------
LPR_APP_MODE=simulation                 # simulation | production
LPR_ALLOW_PRODUCTION_WRITES=false       # must be true AND mode=production for any write to leave

LPR_ENVIRONMENT=local                   # local | dev | staging | prod
LPR_LOG_LEVEL=INFO
LPR_LOG_FORMAT=json                     # json | console

# ---------------------------------------------------------------------------------------------
# Persistence. Leave the DSN empty for the in-memory checkpointer (tests and local demo).
# Setting it selects the Postgres checkpointer, which needs the `postgres` extra installed --
# `pip install -e ".[postgres]"`. psycopg without libpq will not import.
# ---------------------------------------------------------------------------------------------
LPR_POSTGRES_DSN=
# LPR_POSTGRES_DSN=postgresql://lpr:lpr@localhost:5432/lpr_cpe
LPR_POSTGRES_POOL_MIN=1
LPR_POSTGRES_POOL_MAX=10

# ---------------------------------------------------------------------------------------------
# Clock. Fixed UTC-04:00, no daylight saving. The predictive scan windows are expressed in it.
# ---------------------------------------------------------------------------------------------
LPR_TIMEZONE=America/Puerto_Rico
LPR_SCAN_WINDOWS=07:00,21:00

# ---------------------------------------------------------------------------------------------
# Language model. Only ever asked for prose (IMPLEMENTATION_PLAN.md A5/D6). With no key set the
# deterministic fake is used, which is why the test suite needs no network.
# ---------------------------------------------------------------------------------------------
LPR_MODEL_PROVIDER=fake                 # fake | anthropic
LPR_MODEL_NAME=claude-sonnet-4-5
LPR_MODEL_MAX_TOKENS=1024
LPR_MODEL_TIMEOUT_SECONDS=30
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------------------------
# Access-network defaults. Configurable rather than literals in the detectors (D5).
# ---------------------------------------------------------------------------------------------
LPR_DEFAULT_TAP_SIZE=8                  # homes behind one HFC tap
LPR_DEFAULT_ODP_SIZE=16                 # homes behind one PON ODP
LPR_DEFAULT_SPLIT_RATIO=32              # ONTs per PON port

# ---------------------------------------------------------------------------------------------
# External systems. All simulated by default; these are the names a real deployment would fill.
# No value here corresponds to a documented vendor endpoint -- see docs/vendor-integration-gaps.md.
# ---------------------------------------------------------------------------------------------
LPR_NXT_BASE_URL=
LPR_CPE_ACS_BASE_URL=
LPR_TMF_BASE_URL=
LPR_WFM_BASE_URL=
LPR_INVENTORY_BASE_URL=
LPR_JTRACK_BASE_URL=
LPR_GIS_BASE_URL=
LPR_COMMS_BASE_URL=
LPR_EXTERNAL_TIMEOUT_SECONDS=15
LPR_EXTERNAL_MAX_RETRIES=3

# ---------------------------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------------------------
LPR_OTEL_ENABLED=false
LPR_OTEL_ENDPOINT=
LPR_LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=

# ---------------------------------------------------------------------------------------------
# Webhook authentication. Shared secret for the four inbound webhooks; empty disables the check,
# which is refused outright when LPR_ENVIRONMENT=prod.
# ---------------------------------------------------------------------------------------------
LPR_WEBHOOK_SECRET=
